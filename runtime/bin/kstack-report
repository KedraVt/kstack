#!/usr/bin/env bash
# kstack-report — write a step completion record to
#   .kstack/runs/<runId>/<phase>[.<step>].json and append the matching
#   ledger event. This is the delegation completion protocol (S4/ADR-1):
#   records are the canonical source for step summaries, verdicts and
#   routing vars; HANDOFF text survives only as a migration redundancy.
#
# Usage:
#   kstack-report --workflow <id> --run-id <id> --phase <id> [--step <id>] \
#     [--attempt <n>] [--root <project dir>] \
#     [--verdict KEY==VALUE]... [--var KEY==VALUE]... \
#     [--evidence <text>]... [--deliverable <path>]... \
#     [--marker <text>]... [--summary <text>]
#
# The agent learns workflow/runId/phase/step from its task contract — the
# orchestrator interpolates {runId}/{phase}/{step} into step tasks.
#
# The project root decides WHERE .kstack/ lives: --root wins, then
# $KSTACK_PROJECT_ROOT, then the current directory (backward compatible).
# An agent that cd'd elsewhere would otherwise drop its record outside the
# orchestrator's .kstack/ — the step would park as signal-missing.
# Records are UNTRUSTED input: routing re-validates verdict values against
# the (workflow, phase) expectation map before acting on them. When the
# orchestrator publishes that map to the step (KSTACK_VERDICT_VALUES), the
# CLI validates the values at WRITE time: an off-map value, a missing
# declared verdict or a security rejection without a severity is refused
# (nothing is written, exit 1) so the step learns of the mistake now.
#
# SCOPE: the published maps describe ONE step — the env names it
# (KSTACK_PHASE/KSTACK_STEP). A record for a DIFFERENT step (written by a
# nested process that inherited the env) is not validated against that map
# and its verdicts are not dropped: the step's mandates must never refuse
# another step's record.
#
# Exit codes: 0 written · 1 usage error (incl. a refused verdict) · 2 write failure.

set -uo pipefail

WORKFLOW=""
RUN_ID=""
PHASE=""
STEP=""
ATTEMPT=""
ROOT=""
SUMMARY=""
declare -a VERDICTS=()
declare -a VARS=()
declare -a EVIDENCE=()
declare -a DELIVERABLES=()
declare -a MARKERS=()

while [ $# -gt 0 ]; do
  case "$1" in
    --workflow)    WORKFLOW="$2"; shift 2 ;;
    --run-id)      RUN_ID="$2"; shift 2 ;;
    --phase)       PHASE="$2"; shift 2 ;;
    --step)        STEP="$2"; shift 2 ;;
    --attempt)     ATTEMPT="$2"; shift 2 ;;
    --root)        ROOT="$2"; shift 2 ;;
    --verdict)     VERDICTS+=("$2"); shift 2 ;;
    --var)         VARS+=("$2"); shift 2 ;;
    --evidence)    EVIDENCE+=("$2"); shift 2 ;;
    --deliverable) DELIVERABLES+=("$2"); shift 2 ;;
    --marker)      MARKERS+=("$2"); shift 2 ;;
    --summary)     SUMMARY="$2"; shift 2 ;;
    *) echo "kstack-report: unknown flag '$1'" >&2; exit 1 ;;
  esac
done

if [ -z "$WORKFLOW" ] || [ -z "$RUN_ID" ] || [ -z "$PHASE" ]; then
  echo "kstack-report: --workflow, --run-id and --phase are required" >&2
  exit 1
fi

# Project root that owns .kstack/ — the orchestrator reads the record from
# <root>/.kstack/runs, so a record written under another cwd is invisible.
# An empty BASE_DIR keeps the historical relative paths (".kstack/...").
if [ -n "$ROOT" ]; then
  if [ ! -d "$ROOT" ]; then
    echo "kstack-report: --root '$ROOT' is not an existing directory" >&2
    exit 1
  fi
  BASE_DIR="$ROOT"
elif [ -n "${KSTACK_PROJECT_ROOT:-}" ]; then
  if [ ! -d "$KSTACK_PROJECT_ROOT" ]; then
    echo "kstack-report: KSTACK_PROJECT_ROOT '$KSTACK_PROJECT_ROOT' is not an existing directory" >&2
    exit 1
  fi
  BASE_DIR="$KSTACK_PROJECT_ROOT"
else
  BASE_DIR=""
fi

# Verdict ownership: when the orchestrator sets KSTACK_VERDICT_KEYS (space-
# separated; empty = this step owns no gate verdict), verdict keys outside it
# are DROPPED with a warning — the record is still written, so a step is never
# blocked for doing its work, but it cannot produce a verdict it does not own.
# Values are lowercased and stripped of trailing punctuation ("Approved.").
#
# The published maps describe ONE step: the orchestrator exports them to a
# delegated step's env, and every process that step spawns inherits them (a
# test runner, a build, a nested CLI call). The env also NAMES that step
# (KSTACK_PHASE / KSTACK_STEP), so a record for a DIFFERENT step is not the
# step's record — the published mandates do not apply to it and its verdicts
# are not dropped.
env_covers_invocation() {
  if [ -n "${KSTACK_PHASE:-}" ] && [ "$KSTACK_PHASE" != "$PHASE" ]; then return 1; fi
  if [ -n "${KSTACK_STEP:-}" ] && [ "$KSTACK_STEP" != "$STEP" ]; then return 1; fi
  return 0
}

# Does the published ownership map cover this verdict key?
owns_verdict() {
  [ -n "${KSTACK_VERDICT_KEYS+x}" ] || return 0        # no map published: nothing to enforce
  env_covers_invocation || return 0                    # the map belongs to another step
  printf ' %s ' "$KSTACK_VERDICT_KEYS" | grep -qF " $1 "
}

if [ ${#VERDICTS[@]} -gt 0 ]; then
  declare -a KEPT=()
  for pair in "${VERDICTS[@]}"; do
    case "$pair" in *==*) ;; *) KEPT+=("$pair"); continue ;; esac
    key="${pair%%==*}"
    val="$(printf '%s' "${pair#*==}" | tr '[:upper:]' '[:lower:]' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:].,;:!]*$//')"
    if owns_verdict "$key"; then
      KEPT+=("$key==$val")
    else
      owned_desc="${KSTACK_VERDICT_KEYS:-}"
      [ -n "$owned_desc" ] || owned_desc="no gate verdict"
      echo "kstack-report: ignoring --verdict '$key' — this step owns $owned_desc" >&2
    fi
  done
  VERDICTS=("${KEPT[@]+"${KEPT[@]}"}")
fi

# Verdict VALUE validation (write time). The orchestrator publishes the
# accepted values of the keys this step OWNS as "key=v1,v2 key2=v1,v2"
# (KSTACK_VERDICT_VALUES). A verdict outside its list is a mistake the step
# must learn NOW — the record is NOT written and the CLI exits 1. Without the
# env (a main-session step has no per-step env) the behaviour is unchanged.
# The published map covers the step the env NAMES: a record for another step
# (a nested process that inherited the env) is not validated against it.
if [ -n "${KSTACK_VERDICT_VALUES:-}" ] && env_covers_invocation; then
  # The accepted values of one key (empty when the key has no map entry).
  accepted_for() {
    local want="$1" entry
    for entry in ${KSTACK_VERDICT_VALUES:-}; do
      case "$entry" in
        "$want"=*) printf '%s' "${entry#*=}"; return 0 ;;
      esac
    done
    return 1
  }

  # Is a value inside a comma separated list?
  list_has() {
    local list="$1" want="$2" item
    local IFS=','
    for item in $list; do
      if [ "$item" = "$want" ]; then return 0; fi
    done
    return 1
  }

  # 1. An owned verdict carrying a value outside its accepted list.
  for pair in "${KEPT[@]+"${KEPT[@]}"}"; do
    vkey="${pair%%==*}"
    vval="${pair#*==}"
    allowed="$(accepted_for "$vkey")"
    [ -n "$allowed" ] || continue
    if ! list_has "$allowed" "$vval"; then
      echo "kstack-report: --verdict '$vkey==$vval' is not accepted for '$vkey' (accepted: ${allowed//,/ | }) — nothing was written" >&2
      exit 1
    fi
  done

  # 2. The step's declared signal verdict is mandatory: a record without it
  #    is signal-missing and the phase re-issues the step. The mandate is
  #    scoped to the keys the step OWNS: a required key outside
  #    KSTACK_VERDICT_KEYS is dropped by the writer, so enforcing it would
  #    refuse every record the step could ever write (a deadlock).
  if [ -n "${KSTACK_VERDICT_REQUIRED:-}" ]; then
    required_owned=1
    if [ -n "${KSTACK_VERDICT_KEYS+x}" ]; then
      printf ' %s ' "$KSTACK_VERDICT_KEYS" | grep -qF " $KSTACK_VERDICT_REQUIRED " || required_owned=0
    fi
    if [ "$required_owned" -eq 1 ]; then
      have_required=0
      for pair in "${KEPT[@]+"${KEPT[@]}"}"; do
        if [ "${pair%%==*}" = "$KSTACK_VERDICT_REQUIRED" ]; then have_required=1; break; fi
      done
      if [ "$have_required" -eq 0 ]; then
        echo "kstack-report: this step's record MUST carry --verdict '$KSTACK_VERDICT_REQUIRED==<value>' — it is missing — nothing was written" >&2
        exit 1
      fi
    fi
  fi

  # 3. D3: a security rejection without a severity is not a verdict — the
  #    phase cannot route it, so the record is refused instead of parked.
  sec_value=""
  sev_value=""
  for pair in "${KEPT[@]+"${KEPT[@]}"}"; do
    case "$pair" in
      security-review==*) sec_value="${pair#*==}" ;;
      severity==*) sev_value="${pair#*==}" ;;
    esac
  done
  if [ "$sec_value" = "rejected" ] && [ -z "$sev_value" ]; then
    echo "kstack-report: --verdict 'security-review==rejected' needs a 'severity' verdict in the SAME call — nothing was written" >&2
    exit 1
  fi
fi

# Sanitize path segments — record/ledger filenames must never escape
# .kstack/ (same allowlist as ledgerPathFor: word chars + hyphen + dot).
safe() { printf '%s' "$1" | tr -c '[:alnum:]_.-' '-'; }
# Sanitize a JSON string value (strip quotes, backslashes, control chars).
js() { printf '%s' "$1" | tr -d '"\\\n\r\t' | head -c 4000; }
# Sanitize a map key.
jk() { printf '%s' "$1" | tr -c '[:alnum:]_.-' '-' | head -c 80; }

SAFE_RUN="$(safe "$RUN_ID")"
SAFE_PHASE="$(safe "$PHASE")"
SAFE_STEP="$(safe "$STEP")"
SAFE_WF="$(safe "$WORKFLOW")"

RECORD_DIR="${BASE_DIR:+$BASE_DIR/}.kstack/runs/$SAFE_RUN"
if [ -n "$SAFE_STEP" ]; then
  RECORD_FILE="$RECORD_DIR/$SAFE_PHASE.$SAFE_STEP.json"
else
  RECORD_FILE="$RECORD_DIR/$SAFE_PHASE.json"
fi
LEDGER_DIR="${BASE_DIR:+$BASE_DIR/}.kstack/ledger"
# The ledger filename uses ledger.ts's allowlist (no dot): with the record
# allowlist, ISO runIds ("...52.631Z...") split every run into two files.
lsafe() { printf '%s' "$1" | tr -c '[:alnum:]_-' '-'; }
LEDGER_FILE="$LEDGER_DIR/$(lsafe "$WORKFLOW")-$(lsafe "$RUN_ID").jsonl"

TS="$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ)"

# Build a JSON object body from KEY==VALUE pairs (first == splits; a pair
# without == is dropped as malformed).
map_json() {
  local out="{" first=1 pair key val
  for pair in "$@"; do
    case "$pair" in
      *==*) ;;
      *) continue ;;
    esac
    key="${pair%%==*}"
    val="${pair#*==}"
    [ $first -eq 0 ] && out+=","
    out+="\"$(jk "$key")\":\"$(js "$val")\""
    first=0
  done
  out+="}"
  printf '%s' "$out"
}

# Build a JSON array body from raw strings.
arr_json() {
  local out="[" first=1 item
  for item in "$@"; do
    [ $first -eq 0 ] && out+=","
    out+="\"$(js "$item")\""
    first=0
  done
  out+="]"
  printf '%s' "$out"
}

VERDICTS_JSON="$(map_json "${VERDICTS[@]+"${VERDICTS[@]}"}")"
VARS_JSON="$(map_json "${VARS[@]+"${VARS[@]}"}")"
EVIDENCE_JSON="$(arr_json "${EVIDENCE[@]+"${EVIDENCE[@]}"}")"
DELIVERABLES_JSON="$(arr_json "${DELIVERABLES[@]+"${DELIVERABLES[@]}"}")"
MARKERS_JSON="$(arr_json "${MARKERS[@]+"${MARKERS[@]}"}")"
SUMMARY_JSON="\"$(js "$SUMMARY")\""
[ -z "$SUMMARY" ] && SUMMARY_JSON="null"
STEP_JSON="null"
[ -n "$SAFE_STEP" ] && STEP_JSON="\"$SAFE_STEP\""

mkdir -p "$RECORD_DIR" "$LEDGER_DIR" 2>/dev/null || {
  echo "kstack-report: cannot create .kstack dirs" >&2
  exit 2
}

printf '{"v":1,"workflow":"%s","runId":"%s","phase":"%s","step":%s,"at":"%s","summary":%s,"verdicts":%s,"vars":%s,"evidence":%s,"deliverables":%s,"markers":%s}\n' \
  "$SAFE_WF" "$SAFE_RUN" "$SAFE_PHASE" "$STEP_JSON" "$TS" \
  "$SUMMARY_JSON" "$VERDICTS_JSON" "$VARS_JSON" "$EVIDENCE_JSON" \
  "$DELIVERABLES_JSON" "$MARKERS_JSON" > "$RECORD_FILE" || {
  echo "kstack-report: failed writing $RECORD_FILE" >&2
  exit 2
}

# Ledger event — same JSONL schema as orchestrator/ledger.ts. `record`
# points at the full record file so the ledger line stays small.
ATTEMPT_JSON="null"
[ -n "$ATTEMPT" ] && ATTEMPT_JSON="$ATTEMPT"
printf '{"at":"%s","kind":"report","workflowId":"%s","phaseId":"%s","stepId":%s,"attempt":%s,"payload":{"summary":%s,"verdicts":%s,"vars":%s,"record":"%s"}}\n' \
  "$TS" "$SAFE_WF" "$SAFE_PHASE" "$STEP_JSON" "$ATTEMPT_JSON" \
  "$SUMMARY_JSON" "$VERDICTS_JSON" "$VARS_JSON" "$RECORD_FILE" >> "$LEDGER_FILE" || {
  echo "kstack-report: record written but ledger append failed" >&2
  exit 2
}

printf '%s\n' "$RECORD_FILE"
exit 0
