#!/usr/bin/env bash
# kstack-review-read — read review log and config for dashboard
# Usage: kstack-review-read
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
eval "$("$SCRIPT_DIR/kstack-slug" 2>/dev/null)"
KSTACK_HOME="${KSTACK_HOME:-$HOME/.kstack}"
cat "$KSTACK_HOME/projects/$SLUG/$BRANCH-reviews.jsonl" 2>/dev/null || echo "NO_REVIEWS"
echo "---CONFIG---"
"$SCRIPT_DIR/kstack-config" get skip_eng_review 2>/dev/null || echo "false"
echo "---HEAD---"
git rev-parse --short HEAD 2>/dev/null || echo "unknown"
