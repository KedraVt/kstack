{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "lib": ["ES2023"]
  },
  "include": [
    "orchestrator/**/*.ts",
    "lib/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "tools.generated.ts",
    "index.ts"
  ],
  "exclude": [
    "browser"
  ]
}
