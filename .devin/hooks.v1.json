{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"${DEVIN_PROJECT_DIR:-.}/.devin/hooks/graft-hooks.cjs\" session-start",
          "timeout": 10
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"${DEVIN_PROJECT_DIR:-.}/.devin/hooks/graft-hooks.cjs\" prompt",
          "timeout": 15
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "^(edit|write|multi_edit|notebook_edit)$",
      "hooks": [
        {
          "type": "command",
          "command": "node \"${DEVIN_PROJECT_DIR:-.}/.devin/hooks/graft-hooks.cjs\" post-edit",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "^(exec|read|grep|find_file_by_name|mcp__graft__.*)$",
      "hooks": [
        {
          "type": "command",
          "command": "node \"${DEVIN_PROJECT_DIR:-.}/.devin/hooks/graft-hooks.cjs\" devin-tool-savings",
          "timeout": 8
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"${DEVIN_PROJECT_DIR:-.}/.devin/hooks/graft-hooks.cjs\" stop",
          "timeout": 10
        }
      ]
    }
  ]
}
